# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O arquivo ".env" contém segredos: NUNCA publique nem envie para repositórios.
# Para gerar a senha do painel automaticamente, use:  node tools/criar-senha.js

# Porta e endereço do servidor.
# Local: 127.0.0.1. Em produção atrás de proxy/plataforma, geralmente 0.0.0.0 (e a PORT definida pela hospedagem).
PORT=3000
HOST=127.0.0.1

# Use "true" quando o site estiver atrás de um proxy reverso (Nginx, Caddy, Render, Railway etc.),
# para identificar o IP real dos visitantes nos limites de tentativas. Localmente deixe "false".
TRUST_PROXY=false

# Usuário do painel administrativo
ADMIN_USER=equipe

# Hash da senha do painel (gerado pelo tools/criar-senha.js). Não coloque a senha em texto puro.
ADMIN_PASSWORD_HASH=

# Endereço público definitivo do site, quando houver domínio (ex.: https://www.exemplo.com.br).
# Enquanto estiver vazio, o site envia "noindex" para não ser indexado por buscadores.
PUBLIC_BASE_URL=

# Use "true" quando o site estiver em HTTPS (produção). Localmente deixe "false".
COOKIE_SECURE=false

# Pasta dos dados persistentes (conteúdo, mensagens, uploads, backups). Padrão: ./data
# Em produção, aponte para um DISCO PERSISTENTE fora da pasta do código (ex.: /var/lib/officecast/data),
# para que publicar uma versão nova do código nunca apague o conteúdo cadastrado.
DATA_DIR=
